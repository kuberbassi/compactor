{
  "name": "compactor",
  "private": true,
  "version": "0.0.0",
  "packageManager": "npm@11.9.0",
  "engines": { "node": ">=24 <25", "npm": ">=11 <12" },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:compressors": "node scripts/check-compressors.cjs",
    "check:tablet-video": "node scripts/check-tablet-video.mjs",
    "check:mobile-nav": "node scripts/check-mobile-nav.mjs",
    "check:compact-compressors": "node scripts/check-compact-compressors.mjs",
    "check:compact-media": "node scripts/check-compact-media.mjs",
    "check:compact-converter": "node scripts/check-compact-converter.mjs",
    "check:compact-pdf": "node scripts/check-compact-pdf.mjs",
    "check:responsive": "node scripts/check-responsive-acceptance.mjs",
    "check:tablet-routes": "node scripts/check-tablet-routes.mjs",
    "check:tablet-workspaces": "node scripts/check-tablet-workspaces.mjs",
    "check:seo": "node scripts/check-seo-build.mjs",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "quality": "npm run lint && npm run test && npm run build && npm run check:seo",
    "check:production": "npm run quality && npm run check:compressors && npm audit --omit=dev --audit-level=high",
    "test:browser:smoke": "npm run check:responsive",
    "test:browser:responsive": "node scripts/check-responsive-acceptance.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/roboto-mono": "^5.3.0",
    "@pdfsmaller/pdf-decrypt": "^1.0.1",
    "@pdfsmaller/pdf-encrypt": "^1.2.0",
    "@react-three/fiber": "9.8.1",
    "@react-three/postprocessing": "3.1.2",
    "@types/html2canvas": "^0.5.35",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "docx": "^9.7.2",
    "docx-preview": "^0.4.1",
    "fflate": "^0.8.3",
    "html2canvas": "^1.4.1",
    "imagetracerjs": "^1.2.6",
    "lucide-react": "^1.48.0",
    "mammoth": "^1.12.3",
    "marked": "^18.0.14",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "pdfmake": "^0.3.11",
    "postprocessing": "6.39.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rubberband-wasm": "^3.3.0",
    "soundtouchjs": "^0.3.0",
    "tailwind-merge": "^3.7.0",
    "tesseract.js": "^7.0.0",
    "three": "0.186.1",
    "web-audio-beat-detector": "^8.2.39"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/pdfmake": "^0.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^29.1.1",
    "oxlint": "^1.85.0",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.1",
    "vitest": "^4.1.11"
  }
}
