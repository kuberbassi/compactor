# Optional in local development: point localhost at the deployed production API
# so successful local file operations contribute to the same persistent total.
VITE_PROCESSED_COUNT_API_URL=https://your-production-domain.example/api/processed-count

# Configure these only in Vercel/server-side environment settings.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Add extra trusted development origins if the local port/domain differs.
COUNTER_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
